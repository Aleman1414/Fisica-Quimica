# ==============================================================================
# CONFIGURACIÓN DE FIREBASE (FRONTEND - VITE)
# Copiar este archivo como .env.local (desarrollo) o configurar en Vercel (producción)
# ==============================================================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# ==============================================================================
# CONFIGURACIÓN DE FIREBASE APP CHECK (OPCIONAL EN DESARROLLO, RECOMENDADO EN PROD)
# ==============================================================================
VITE_RECAPTCHA_V3_SITE_KEY=your_recaptcha_v3_site_key
VITE_APPCHECK_DEBUG_TOKEN=false

# ==============================================================================
# CONFIGURACIÓN DE EMULADORES LOCALES (DESARROLLO)
# ==============================================================================
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIRESTORE_EMULATOR_HOST=localhost:8080
VITE_AUTH_EMULATOR_HOST=http://localhost:9099
VITE_FUNCTIONS_EMULATOR_HOST=localhost:5001

# ==============================================================================
# CREDENCIALES ADMINISTRATIVAS INICIALES (PARA VINCULACIÓN DE ROL ADMIN)
# ==============================================================================
VITE_ADMIN_ALLOWED_EMAILS=admin@institucion.edu.hn,docente.ciencias@institucion.edu.hn
